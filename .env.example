# Copie para .env e preencha. O .env nunca vai para o git.

# jkcontrol.online — token de API (ag_...) com papel "viewer", da organização do cliente
JKCONTROL_URL=https://jkcontrol.online
JKCONTROL_TOKEN=ag_coloque_aqui

# OpenMES — usuário de serviço com papel Supervisor (veja o README)
OPENMES_URL=http://localhost:8080
OPENMES_USERNAME=conector
OPENMES_PASSWORD=
# Alternativa ao usuário/senha. Expira em 15 min por padrão — prefira usuário/senha.
# OPENMES_TOKEN=

# Fuso da fábrica: o MESMO configurado no OpenMES (Configurações → fuso horário)
OPENMES_TIMEZONE=America/Sao_Paulo

# Ciclo de leitura e janela de sobreposição
POLL_INTERVAL_SECONDS=15
OVERLAP_MINUTES=15
# Na primeira execução (sem estado salvo), quanto do passado ler
INITIAL_LOOKBACK_MINUTES=60
PAGE_SIZE=500

CONFIG_FILE=./config.json
STATE_FILE=./data/state.json
